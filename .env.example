# ==========================================
# Acquisitions API - Environment Template
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Database Connection URL:
# For Dev (Neon Local proxy inside Docker): postgres://user:password@neon-local:5432/dbname
# For Dev (Host machine tools): postgres://user:password@localhost:5432/dbname
# For Prod (Neon Cloud): postgresql://<user>:<password>@<neon-host>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgres://user:password@neon-local:5432/dbname

# Neon API credentials (Required only for Neon Local in Dev)
NEON_API_KEY=napi_your_neon_api_key_here
NEON_PROJECT_ID=your_neon_project_id_here
PARENT_BRANCH_ID=main
